{
  "name": "ai-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run generate && tsc --noEmit && vite build",
    "start": "tsx src/server.ts",
    "generate": "prisma generate",
    "db:sql": "tsx scripts/schema-sql.ts",
    "db:apply": "tsx scripts/db-apply.ts",
    "check": "npm run build && npm test",
    "test": "vitest run --root . tests",
    "test:ui": "playwright test",
    "format": "prettier --write \"src/*.ts\" web scripts tests e2e \"*.ts\" .vscode package.json tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "google-auth-library": "11.3.1",
    "graphql": "17.0.2",
    "mercurius": "16.12.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
